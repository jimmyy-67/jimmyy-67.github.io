{
  "name": "jimmyy-67-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "check": "npm run lint && npm run format:check && npm run check-links:local && npm run check-content",
    "check-content": "node scripts/check-content.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check-links:local": "node scripts/check-links.mjs --skip-external",
    "lint": "npm run lint:html && npm run lint:js && npm run lint:css",
    "lint:html": "htmlhint index.html",
    "lint:js": "eslint .",
    "lint:css": "biome lint styles.css",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,md,yml,yaml}\" .htmlhintrc",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,md,yml,yaml}\" .htmlhintrc"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "htmlhint": "1.9.2",
    "prettier": "3.9.9"
  }
}
