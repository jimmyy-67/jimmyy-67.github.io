{
  "name": "jimmyy-67-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "check": "npm run lint && npm run format:check && npm run validate-manifest:local && npm run check-links:local && npm run check:media && npm run check:versions",
    "check:media": "node scripts/check-media.mjs",
    "check:versions": "node scripts/check-asset-versions.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check-links:local": "node scripts/check-links.mjs --skip-external",
    "validate-manifest": "node scripts/validate-manifest.mjs",
    "validate-manifest:local": "node scripts/validate-manifest.mjs --skip-external",
    "optimize:media": "node scripts/optimize-media.mjs",
    "optimize:media:videos": "node scripts/optimize-media.mjs --reencode-videos",
    "lint": "npm run lint:html && npm run lint:js && npm run lint:css",
    "lint:html": "htmlhint index.html",
    "lint:js": "eslint .",
    "lint:css": "biome lint styles.css",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,md,yml,yaml}\" .htmlhintrc",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,md,yml,yaml}\" .htmlhintrc",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:pa11y": "node scripts/run-pa11y.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "htmlhint": "1.9.2",
    "prettier": "3.9.9",
    "sharp": "^0.35.5"
  }
}
