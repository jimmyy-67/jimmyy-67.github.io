{
  "name": "jimmyy-67-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "check": "npm run lint && npm run format:check && npm run check-links -- --skip-external",
    "check-links": "node scripts/check-links.mjs",
    "lint": "npm run lint:html && npm run lint:js && npm run lint:css",
    "lint:html": "htmlhint index.html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,md,yml,yaml}\" .htmlhintrc",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,md,yml,yaml}\" .htmlhintrc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "htmlhint": "^1.9.2",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
